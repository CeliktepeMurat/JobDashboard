# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# PostgreSQL connection string
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://johndoe:randompassword@localhost:5432/job_dashboard?schema=public"

# SerpApi key — used in /api/fetch-jobs to call the Google Jobs engine
# Get one at https://serpapi.com
SERPAPI_KEY=""

# Apify API token — used in /api/fetch-jobs to trigger the LinkedIn scraper actor
# Get one at https://apify.com
APIFY_TOKEN=""

# Apify actor ID for the LinkedIn job scraper
# Example: "apify/linkedin-jobs-scraper"
APIFY_ACTOR_ID=""

# Secret used to authenticate the /api/fetch-jobs cron endpoint
# Generate a random string: openssl rand -hex 32
CRON_SECRET=""
